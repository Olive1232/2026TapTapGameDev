; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="2026聚光灯"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

CoinPool="*res://scripts/economy/coin_pool.gd"
EventBus="*res://scripts/autoload/event_bus.gd"
Wallet="*res://scripts/autoload/wallet.gd"
SaveGame="*res://scripts/autoload/save_game.gd"
GameSettings="*res://scripts/autoload/game_settings.gd"
GameFlow="*res://scripts/autoload/game_flow.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/min_width=960
window/size/min_height=640

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg", "res://addons/sprite_forge/plugin.cfg")

[gui]

theme/custom_font="res://resources/ui/game_font.tres"

